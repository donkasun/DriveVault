# Copy to .env.local and fill in. NEVER commit real secrets.
# Mirrors backend/.env.example for the FastAPI → Next.js migration.

# local | production
ENVIRONMENT=local

# Local Docker Postgres (host port often 5433 — see docs/ops-notes.md).
# Neon URL in production (Vercel env).
DATABASE_URL=postgresql://drivevault:drivevault@localhost:5433/drivevault

FIREBASE_PROJECT_ID=drivevault-app
# Service-account JSON string (or path during local-only experiments — prefer JSON string)
FIREBASE_CREDENTIALS_JSON=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated browser origins (mobile apps do not need CORS)
CORS_ORIGINS=*

# Guards POST /api/v1/internal/process-reminders
INTERNAL_SECRET=
