# Copy to .env and fill in. NEVER commit the real .env.
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Local Docker Postgres (matches docker-compose.yml). Use the Neon URL in production.
DATABASE_URL=postgresql+psycopg://drivevault:drivevault@localhost:5432/drivevault

# Firebase (leave blank for tests — auth is mocked there)
FIREBASE_PROJECT_ID=drivevault-app
FIREBASE_CREDENTIALS_JSON=

# Cloudinary file/photo storage (API secret is server-side only — never ship to client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS: comma-separated origins ("*" for local dev)
CORS_ORIGINS=*
