# Copy to .env.local and fill in. Never commit .env.local.

# API base URL. Two valid local backends — same contract, different host:
#   FastAPI (Docker):  http://localhost:8000/api/v1   (being retired)
#   Next.js (web/):    http://localhost:3000/api/v1   (post-cutover host)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Web config (Project settings → General → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Google OAuth web client ID (expo-auth-session → Firebase credential exchange)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
